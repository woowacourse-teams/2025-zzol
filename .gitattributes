# nginx/monitoring 설정·compose 파일은 Linux 컨테이너로 배포되므로 LF로 고정한다.
# Windows에서 편집·커밋해도 CRLF로 변환되지 않도록 강제 (nginx -t 오류 및 무의미한 diff 방지).
backend/docker/** text eol=lf
.github/scripts/** text eol=lf

# ws-catalog fixture 는 CI 가 재생성 결과와 커밋본을 git diff 로 대조한다.
# 줄바꿈이 OS 마다 달라지면 내용이 같아도 diff 가 떠서 게이트가 깜빡인다.
backend/app/src/test/resources/__fixtures__/** text eol=lf
frontend/src/apis/websocket/generated/** text eol=lf
