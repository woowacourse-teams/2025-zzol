#!/bin/sh
# push 전 로컬 lint 검증 — CI의 lint 단계가 깨지기 전에 잡는다 (#1659).
#
# 켜기: git config core.hooksPath .githooks
#       (frontend `npm install` 또는 `./gradlew build` 가 자동으로 설정한다)
# 한 번 건너뛰기: git push --no-verify
#       — CI에서 같은 검사가 다시 도므로, 건너뛴 책임은 push한 사람에게 있다.
#
# 검사 범위는 CI와 같다(backend-ci.yml / frontend-ci.yml). 다르면 로컬에서 통과하고 CI가 깨진다.

git fetch -q origin dev 2>/dev/null

# 삭제된 파일은 제외한다(ACMR) — 없는 경로를 lint에 넘기면 그것만으로 실패한다.
CHANGED=$(git diff --name-only --diff-filter=ACMR origin/dev...HEAD)

# 백엔드 — Spotless는 ratchetFrom("origin/dev")라 변경 파일만 본다. PMD 대상도 CI와 맞춘다.
if printf '%s\n' "$CHANGED" | grep -q '^backend/.*\.java$'; then
    echo "[pre-push] backend lint (spotless + pmd)…"
    if ! backend/gradlew -p backend --console=plain spotlessCheck pmdMain pmdTest pmdTestFixtures; then
        echo "[pre-push] backend lint 실패 — 포맷은 'backend/gradlew -p backend spotlessApply',"
        echo "           PMD 지적은 위 리포트를 보고 직접 고치세요."
        exit 1
    fi
fi

# 프론트 — 변경된 파일만 ESLint. 경로에서 frontend/ 를 떼야 frontend/ 안에서 실행할 수 있다.
FE=$(printf '%s\n' "$CHANGED" | sed -n 's|^frontend/\(.*\.[cm]\{0,1\}[jt]sx\{0,1\}\)$|\1|p')
if [ -n "$FE" ]; then
    if [ ! -d frontend/node_modules ]; then
        echo "[pre-push] frontend/node_modules 없음 — eslint를 건너뛴다. 'npm install' 후 다시 push하세요."
    else
        echo "[pre-push] frontend eslint…"
        # --no-warn-ignored: eslint.config.js 가 무시하는 파일을 명시로 넘길 때 나는 경고를 죽인다.
        if ! printf '%s\n' "$FE" | tr '\n' '\0' | (cd frontend && xargs -0 npx eslint --no-warn-ignored); then
            echo "[pre-push] eslint 실패 — 'cd frontend && npm run lint:fix' 후 다시 커밋하세요."
            exit 1
        fi
    fi
fi

# 백엔드 WS 계약 — 게이트는 backend-ci 다. 여기선 이번에 올라가는 커밋의 WS 계약 애노테이션 변경만 본다.
# payload record 의 필드만 바뀐 경우는 안 걸리고 CI 가 잡는다.
# 범위를 브랜치 전체로 잡으면 한 번 애노테이션을 건드린 뒤 모든 push 가 30초씩 느려진다.
# 줄 시작을 고정하는 건 주석과 예외 메시지 속 "@WsTopic" 을 거르려는 것이다.
BRANCH=$(git rev-parse --abbrev-ref HEAD)
PUSHED=$(git rev-parse -q --verify "origin/$BRANCH") || PUSHED=$(git merge-base origin/dev HEAD)
git diff "$PUSHED..HEAD" -- backend \
  | grep -qE '^[+-][[:space:]]*@(WsTopic|WsQueue|WsReceive|MessageMapping)[[:space:]]*\(' || exit 0

# 컨트랙트 테스트는 MySQL·Valkey 컨테이너를 띄운다(reuse 는 #1402 에서 영구 비활성).
# Docker 가 꺼졌으면 push 를 막지 않고 CI 에 맡긴다.
if ! docker info >/dev/null 2>&1; then
    echo "[pre-push] Docker 가 꺼져 있어 ws-catalog fixture 검사를 건너뜁니다. backend-ci 가 잡습니다."
    exit 0
fi

# 성공해도 애플리케이션 로그가 수백 줄 나온다. 파일로 받고 실패했을 때만 꼬리를 보여준다.
LOG=$(mktemp -t ws-catalog-pre-push)
echo "[pre-push] ws-catalog fixture 갱신… (컨테이너 기동 포함 30초 내외)"
if ! backend/gradlew -p backend :app:test --tests '*WsCatalogContractTest*' -q >"$LOG" 2>&1; then
    grep -E "발행 경로 상수|수신 문서|expected|but was|Test.*FAILED" "$LOG" | head -20
    echo "[pre-push] 컨트랙트 테스트 실패 — 전체 로그: $LOG"
    echo "  리포트: backend/app/build/reports/tests/test/index.html"
    exit 1
fi
rm -f "$LOG"

git diff --quiet -- backend/app/src/test/resources/__fixtures__/ws-catalog.json && exit 0

echo "[pre-push] ws-catalog fixture 를 갱신했습니다. 커밋에 포함하고 다시 push 하세요:"
echo "  git add backend/app/src/test/resources/__fixtures__/ws-catalog.json"
exit 1
